# --- Core event runner ---
POLY_EVENT_INPUT=
BOT_MODE=dry_run
# Continuous mode is configured via CLI flags:
# --markets btc15,eth15,sol15,btc5,eth5,sol5 --duration-minutes 60 --mode dry_run

# --- Polymarket trading credentials (required for live mode) ---
POLY_PRIVATE_KEY=
CLOB_ADDRESS=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
POLY_CHAIN_ID=137
CLOB_SIGNATURE_TYPE=2
CLOB_HOST=https://clob.polymarket.com

# --- Runtime cadence (ms) ---
INDICATOR_INTERVAL_MS=100
SIGNAL_INTERVAL_MS=100
EXECUTION_INTERVAL_MS=75
SUPABASE_FLUSH_INTERVAL_MS=200
MIN_REMAINING_SECONDS_TO_RUN=1

# --- Entry constraints ---
MAX_ENTRY_PRICE=0.80
MIN_SIGNAL_CONFIDENCE=0.52
MIN_SIGNAL_EDGE=0.10
ENABLE_REVERSAL_IMMINENT=true
VWAP_UP_DELTA_15S=0.003
MID_FLAT_DELTA_15S=0.001
MOMENTUM_ACCEL_5S=0.002
SIGNAL_PERSIST_TICKS=4
ENTRY_COOLDOWN_MS=750
HEDGE_MAX_EXPOSURE_RATIO=0.25
HEDGE_MIN_CONFIDENCE=0.85
HEDGE_MAX_ENTRY_PRICE=0.35
MAX_WAGER_PER_SIDE_USDC=10
MAX_SINGLE_WAGER_USDC=10
MIN_WAGER_USDC=1
MIN_SHARES_PER_PURCHASE=5
ENABLE_CONVEXITY_BUDGET_RESERVATION=false
COUNT_OPEN_ORDERS_IN_EXPOSURE=true
ALLOW_BOTH_SIDES=true
DISALLOW_DUPLICATE_EVENT_RUN=true

# --- Take-profit behavior ---
ENABLE_TAKE_PROFIT=true
TAKE_PROFIT_TRIGGER_PRICE=0.94
TAKE_PROFIT_LIMIT_PRICE=0.95
TAKE_PROFIT_MIN_REMAINING_SEC=120

# --- Supabase tracking (async, non-blocking) ---
SUPABASE_ENABLED=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=copy_pros
SUPABASE_TRACKING_TIMEOUT_MS=250

# --- Logging ---
LOG_LEVEL=INFO
