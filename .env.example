# Supabase project (poly)
SUPABASE_URL=https://cxvntzszdkyggjjenefn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Supabase direct Postgres connection — used by local Python scripts
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Find under: Supabase Dashboard → Project Settings → Database → Connection string (Session mode)
SUPABASE_DB_URL=

# GitHub
GITHUB_PAT=

# Polymarket CLOB — set these as Supabase Edge Function secrets
# supabase secrets set CLOB_API_KEY=... CLOB_SECRET=... CLOB_PASS_PHRASE=...
# CLOB_API_KEY must be your UUID API key (from create_or_derive_api_creds())
# CLOB_ADDRESS must be your wallet address (0x...)
CLOB_ADDRESS=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
